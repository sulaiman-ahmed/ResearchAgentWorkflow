# PostgreSQL (demo stack)
POSTGRES_USER=minibench
POSTGRES_PASSWORD=changeme
POSTGRES_DB=minibench

# Application database URL — uses 'db' hostname (Compose service name)
DATABASE_URL=postgresql+psycopg://minibench:changeme@db:5432/minibench

# Upload storage path inside the API/worker container
UPLOAD_DIR=/app/uploads

# Model provider
# Use 'fake' for local development and CI; set to 'live' only when a key is configured
MODEL_MODE=fake
MODEL_NAME=
MODEL_API_KEY=

# Local API keys — generate distinct random values; never use these defaults in production
# Example: python -c "import secrets; print(secrets.token_hex(32))"
REVIEWER_API_KEY=
WORKER_API_KEY=
